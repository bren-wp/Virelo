{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Virelo",
  "version": "0.1.0",
  "identifier": "com.virelo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [{
      "title": "Virelo",
      "width": 1320,
      "height": 840,
      "minWidth": 760,
      "minHeight": 540,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
